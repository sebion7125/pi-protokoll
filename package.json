{
	"name": "pi-protokoll",
	"version": "0.9.2",
	"description": "Pi extension: a running per-turn protocol replaces summarizing compaction – fast, bounded compaction for very long sessions with local models",
	"type": "module",
	"license": "MIT",
	"author": "sebion7125",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sebion7125/pi-protokoll.git"
	},
	"homepage": "https://github.com/sebion7125/pi-protokoll#readme",
	"bugs": {
		"url": "https://github.com/sebion7125/pi-protokoll/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"compaction",
		"context",
		"local-llm"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src",
		"protokoll.example.json",
		"README.md",
		"README.de.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src tests",
		"format": "biome check --write src tests",
		"check": "npm run typecheck && npm run lint && npm test",
		"e2e": "scripts/e2e.sh"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"@types/node": "^22.10.0",
		"typebox": "1.4.3",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0"
	},
	"engines": {
		"node": ">=22"
	}
}
